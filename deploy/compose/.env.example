# Public hostname
DOMAIN=onetune.example.org

# Optional: enables Tidal. Leave empty to disable it.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_COUNTRY_CODE=US

# Only needed for Android App Links verification of a self-built app (comma-separated SHA-256 fingerprints).
ANDROID_PACKAGE=de.eincybersimon.onetune
ANDROID_CERT_SHA256=
